# Base configuration (loaded first, overridden by environment-specific files)

API_BASE_URL=https://api.example.com
CLIENT_ID=your_client_id_here

CONNECT_TIMEOUT=30000
RECEIVE_TIMEOUT=30000

LOG_LEVEL=info
ENVIRONMENT=development

# Auth: required (must login) | optional (guest-friendly, only some pages need login)
AUTH_MODE=required
# When true, login uses mock data instead of real API
MOCK_AUTH=true
